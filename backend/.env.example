# Database (SQLAlchemy + asyncpg; see compose.yaml)
DATABASE_URL=

# LLM provider (langchain-openai; §9 Model Routing)
OPENAI_API_KEY=

# Model routing — tier→model mapping lives in config, not code (§9)
MODEL_UNDERSTAND=
MODEL_RESPOND=

# Intent classification threshold — below this, the user is asked to
# clarify instead of getting a guessed answer (§3a)
CONFIDENCE_THRESHOLD=

# Global cap on rows returned by any template query (§5)
MAX_ROWS=

# structlog level (app/core/logging.py)
LOG_LEVEL=

# Comma-separated list of allowed CORS origins (app/main.py)
CORS_ORIGINS=

# Per-request LLM spend cap in USD, enforced by RequestBudget
# (app/observability/cost.py). Currently inert — PRICING in
# app/agents/llm.py is still placeholder $0.00 rates.
MAX_REQUEST_COST_USD=
